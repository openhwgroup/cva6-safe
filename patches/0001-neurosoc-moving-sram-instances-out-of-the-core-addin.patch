 core/neurosoc/ecc_enc.sv                   | 217 ++++++++++++++
 core/neurosoc/neurosoc_cache_pkg.sv        | 112 ++++++++
 core/neurosoc/neurosoc_cache_sram_ext.sv   | 254 ++++++++++++++++
 corev_apu/src/ariane.sv                    |  20 +-
 11 files changed, 1051 insertions(+), 120 deletions(-)
