diff --git a/core/cache_subsystem/cva6_icache.sv b/core/cache_subsystem/cva6_icache.sv
index d649473f..14171fd5 100644
--- a/core/cache_subsystem/cva6_icache.sv
+++ b/core/cache_subsystem/cva6_icache.sv
@@ -28,6 +28,7 @@
 module cva6_icache
   import ariane_pkg::*;
   import wt_cache_pkg::*;
+  import neurosoc_cache_pkg::*;
 #(
     parameter config_pkg::cva6_cfg_t CVA6Cfg = config_pkg::cva6_cfg_empty,
     parameter type icache_areq_t = logic,
@@ -59,7 +60,11 @@ module cva6_icache
     input  icache_rtrn_t mem_rtrn_i,
     output logic         mem_data_req_o,
     input  logic         mem_data_ack_i,
-    output icache_req_t  mem_data_o
+    output icache_req_t  mem_data_o,
+
+    // sram icache extern ports
+    output icache_ext_req_t  icache_req,
+    input  icache_ext_resp_t icache_resp
 );
 
   localparam ICACHE_OFFSET_WIDTH = $clog2(CVA6Cfg.ICACHE_LINE_WIDTH / 8);
@@ -107,9 +112,9 @@ module cva6_icache
   logic [     ICACHE_CL_IDX_WIDTH-1:0] cl_index;  // this is a cache-line index, to memory array
   logic [ICACHE_OFFSET_WIDTH-1:0] cl_offset_d, cl_offset_q;  // offset in cache line
   logic [CVA6Cfg.ICACHE_TAG_WIDTH-1:0] cl_tag_d, cl_tag_q;  // this is the cache tag
-  logic [CVA6Cfg.ICACHE_TAG_WIDTH-1:0]          cl_tag_rdata [CVA6Cfg.ICACHE_SET_ASSOC-1:0]; // these are the tags coming from the tagmem
-  logic [CVA6Cfg.ICACHE_LINE_WIDTH-1:0]         cl_rdata     [CVA6Cfg.ICACHE_SET_ASSOC-1:0]; // these are the cachelines coming from the cache
-  logic [CVA6Cfg.ICACHE_USER_LINE_WIDTH-1:0]    cl_ruser[CVA6Cfg.ICACHE_SET_ASSOC-1:0]; // these are the cachelines coming from the user cache
+  logic [CVA6Cfg.ICACHE_SET_ASSOC-1:0][CVA6Cfg.ICACHE_TAG_WIDTH-1:0] cl_tag_rdata; // these are the tags coming from the tagmem
+  logic [CVA6Cfg.ICACHE_SET_ASSOC-1:0][CVA6Cfg.ICACHE_LINE_WIDTH-1:0] cl_rdata; // these are the cachelines coming from the cache
+  logic [CVA6Cfg.ICACHE_SET_ASSOC-1:0][CVA6Cfg.ICACHE_USER_LINE_WIDTH-1:0] cl_ruser; // these are the cachelines coming from the user cache
   logic [CVA6Cfg.ICACHE_SET_ASSOC-1:0][CVA6Cfg.FETCH_WIDTH-1:0] cl_sel;  // selected word from each cacheline
   logic [CVA6Cfg.ICACHE_SET_ASSOC-1:0][CVA6Cfg.FETCH_USER_WIDTH-1:0] cl_user;  // selected word from each cacheline
   logic [CVA6Cfg.ICACHE_SET_ASSOC-1:0] vld_req;  // bit enable for valid regs
@@ -118,6 +123,11 @@ module cva6_icache
   logic [CVA6Cfg.ICACHE_SET_ASSOC-1:0] vld_rdata;  // valid bits coming from valid regs
   logic [ICACHE_CL_IDX_WIDTH-1:0] vld_addr;  // valid bit
 
+  logic [CVA6Cfg.ICACHE_SET_ASSOC-1:0][CVA6Cfg.ICACHE_TAG_WIDTH:0] cl_tag_valid_rdata;
+  logic [CVA6Cfg.ICACHE_SET_ASSOC-1:0][CVA6Cfg.ICACHE_TAG_WIDTH:0] cl_tag_wdata;
+
+  logic ecc_err, ecc_err_q, inv_all_ways_ecc_err;
+
   // cpmtroller FSM
   typedef enum logic [2:0] {
     FLUSH,
@@ -129,6 +139,25 @@ module cva6_icache
   } state_e;
   state_e state_d, state_q;
 
+  ///////////////////////////////////////////////////////
+  // connexion to sram extern arrays
+  ///////////////////////////////////////////////////////
+
+  assign icache_req.data_req = cl_req;
+  assign icache_req.data_we = cl_we;
+  assign icache_req.data_idx = cl_index;
+  assign icache_req.data_wuser = mem_rtrn_i.user;
+  assign icache_req.data_wdata = mem_rtrn_i.data;
+  assign cl_ruser = icache_resp.data_ruser;
+  assign cl_rdata = icache_resp.data_rdata;
+
+  assign icache_req.tag_req = vld_req;
+  assign icache_req.tag_we = vld_we;
+  assign icache_req.tag_idx = vld_addr;
+  assign icache_req.tag_wdata = cl_tag_wdata;
+  assign cl_tag_valid_rdata = icache_resp.tag_rdata;
+  assign ecc_err = icache_resp.ecc_error;
+
   ///////////////////////////////////////////////////////
   // address -> cl_index mapping, interface plumbing
   ///////////////////////////////////////////////////////
@@ -208,6 +237,8 @@ module cva6_icache
     // performance counter
     miss_o = 1'b0;
 
+    inv_all_ways_ecc_err = 1'b0;
+
     // handle invalidations unconditionally
     // note: invald are mutually exclusive with
     // ifills, since both arrive over the same IF
@@ -271,8 +302,18 @@ module cva6_icache
           // check if we have to flush
           if (flush_d) begin
             state_d = IDLE;
+          end else if (ecc_err && ~dreq_i.kill_s2) begin
+            cmp_en_d = 1'b0;
+            // only count this as a miss if the cache is enabled, and
+            // the address is cacheable
+            // send out ifill request
+            mem_data_req_o = 1'b1;
+            if (mem_data_ack_i) begin
+              inv_all_ways_ecc_err = 1'b1;
+              state_d = MISS;
+            end
             // we have a hit or an exception output valid result
-          end else if (((|cl_hit && cache_en_q) || areq_i.fetch_exception.valid) && !inv_q) begin
+          end else if (((|cl_hit && cache_en_q) || areq_i.fetch_exception.valid) && !inv_q && !ecc_err_q) begin
             dreq_o.valid = ~dreq_i.kill_s2;  // just don't output in this case
             state_d      = IDLE;
 
@@ -374,7 +415,8 @@ module cva6_icache
                     (inv_en)         ? mem_rtrn_i.inv.idx[CVA6Cfg.ICACHE_INDEX_WIDTH-1:ICACHE_OFFSET_WIDTH] :
                                        cl_index;
 
-  assign vld_req  = (flush_en || cache_rden)        ? '1                                    :
+  assign vld_req  = (inv_all_ways_ecc_err)          ? '1                                    :
+                    (flush_en || cache_rden)        ? '1                                    :
                     (mem_rtrn_i.inv.all && inv_en)  ? '1                                    :
                     (mem_rtrn_i.inv.vld && inv_en)  ? icache_way_bin2oh(
       mem_rtrn_i.inv.way
@@ -382,7 +424,7 @@ module cva6_icache
 
   assign vld_wdata = (cache_wren) ? '1 : '0;
 
-  assign vld_we = (cache_wren | inv_en | flush_en);
+  assign vld_we = (cache_wren | inv_en | flush_en | ecc_err);
   // assign vld_req   = (vld_we | cache_rden);
 
 
@@ -452,54 +494,12 @@ module cva6_icache
   // memory arrays and regs
   ///////////////////////////////////////////////////////
 
-
-  logic [CVA6Cfg.ICACHE_TAG_WIDTH:0] cl_tag_valid_rdata[CVA6Cfg.ICACHE_SET_ASSOC-1:0];
-
   for (genvar i = 0; i < CVA6Cfg.ICACHE_SET_ASSOC; i++) begin : gen_sram
-    // Tag RAM
-    sram #(
-        // tag + valid bit
-        .DATA_WIDTH(CVA6Cfg.ICACHE_TAG_WIDTH + 1),
-        .NUM_WORDS (ICACHE_NUM_WORDS)
-    ) tag_sram (
-        .clk_i  (clk_i),
-        .rst_ni (rst_ni),
-        .req_i  (vld_req[i]),
-        .we_i   (vld_we),
-        .addr_i (vld_addr),
-        // we can always use the saved tag here since it takes a
-        // couple of cycle until we write to the cache upon a miss
-        .wuser_i('0),
-        .wdata_i({vld_wdata[i], cl_tag_q}),
-        .be_i   ('1),
-        .ruser_o(),
-        .rdata_o(cl_tag_valid_rdata[i])
-    );
-
+    assign cl_tag_wdata[i] = {vld_wdata[i], cl_tag_q};
     assign cl_tag_rdata[i] = cl_tag_valid_rdata[i][CVA6Cfg.ICACHE_TAG_WIDTH-1:0];
     assign vld_rdata[i]    = cl_tag_valid_rdata[i][CVA6Cfg.ICACHE_TAG_WIDTH];
-
-    // Data RAM
-    sram #(
-        .USER_WIDTH(CVA6Cfg.ICACHE_USER_LINE_WIDTH),
-        .DATA_WIDTH(CVA6Cfg.ICACHE_LINE_WIDTH),
-        .USER_EN   (CVA6Cfg.FETCH_USER_EN),
-        .NUM_WORDS (ICACHE_NUM_WORDS)
-    ) data_sram (
-        .clk_i  (clk_i),
-        .rst_ni (rst_ni),
-        .req_i  (cl_req[i]),
-        .we_i   (cl_we),
-        .addr_i (cl_index),
-        .wuser_i(mem_rtrn_i.user),
-        .wdata_i(mem_rtrn_i.data),
-        .be_i   ('1),
-        .ruser_o(cl_ruser[i]),
-        .rdata_o(cl_rdata[i])
-    );
   end
 
-
   always_ff @(posedge clk_i or negedge rst_ni) begin : p_regs
     if (!rst_ni) begin
       cl_tag_q      <= '0;
@@ -512,6 +512,7 @@ module cva6_icache
       cl_offset_q   <= '0;
       repl_way_oh_q <= '0;
       inv_q         <= '0;
+      ecc_err_q     <= '0;
     end else begin
       cl_tag_q      <= cl_tag_d;
       flush_cnt_q   <= flush_cnt_d;
@@ -523,13 +524,13 @@ module cva6_icache
       cl_offset_q   <= cl_offset_d;
       repl_way_oh_q <= repl_way_oh_d;
       inv_q         <= inv_d;
+      ecc_err_q     <= ecc_err;
     end
   end
 
   ///////////////////////////////////////////////////////
   // assertions
   ///////////////////////////////////////////////////////
-
   //pragma translate_off
 `ifndef VERILATOR
   repl_inval0 :
